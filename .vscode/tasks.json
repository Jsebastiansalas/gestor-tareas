{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar con Maven",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "compile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
